{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.5.8",
  "default_locale": "ru",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://videoner.download/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.vimeo.com/*",
        "https://*.vk.com/*",
        "https://*.vk.ru/*",
        "https://*.vkvideo.ru/*",
        "https://*.rutube.ru/*",
        "https://*.ok.ru/*",
        "https://*.pinterest.com/*",
        "https://*.pinterest.ru/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ],
      "js": [
        "video-pages.js",
        "page-media.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.gceuproxy.com/sign-player/*",
        "https://*.gcvh.ru/sign-player/*",
        "https://*.getcourse.ru/sign-player/*"
      ],
      "js": [
        "getcourse.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css",
        "shared.js",
        "getcourse-hls.js",
        "icons/*"
      ],
      "matches": [
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.vimeo.com/*",
        "https://*.vk.com/*",
        "https://*.vk.ru/*",
        "https://*.vkvideo.ru/*",
        "https://*.rutube.ru/*",
        "https://*.ok.ru/*",
        "https://*.pinterest.com/*",
        "https://*.pinterest.ru/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ]
    },
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css",
        "shared.js",
        "getcourse-hls.js",
        "icons/*"
      ],
      "matches": [
        "https://*.gceuproxy.com/*",
        "https://*.gcvh.ru/*",
        "https://*.getcourse.ru/*"
      ]
    }
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.vk.com/*",
    "https://*.vk.ru/*",
    "https://*.vkvideo.ru/*",
    "https://*.tiktok.com/*"
  ]
}
