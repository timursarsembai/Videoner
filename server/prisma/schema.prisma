datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ApiKey {
  id          String     @id @default(uuid())
  key         String     @unique
  name        String // Descriptive name for the API key
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isBlocked   Boolean    @default(false)
  blockReason String?
  ipWhitelist String[] // Array of allowed IP addresses
  rateLimit   Int        @default(100) // Requests per minute
  maxDuration Int        @default(1800) // Maximum media duration in seconds (default 30 minutes)
  downloads   Download[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([key])
  @@index([userId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  apiKeys   ApiKey[]
  isAdmin   Boolean  @default(false)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Download {
  id            String         @id @default(uuid())
  originalUrl   String
  status        DownloadStatus @default(PENDING)
  filename      String
  downloadUrl   String?
  downloader    Downloaders    @default(YOUTUBE)
  apiKey        ApiKey?        @relation(fields: [apiKeyId], references: [id])
  apiKeyId      String?
  botUser       BotUser?       @relation(fields: [botUserId], references: [id])
  botUserId     String?
  source        DownloadSource @default(API)
  videoTitle    String?
  videoDuration Int?
  // Размеры видео нужны боту для sendVideo: без width/height Telegram на iOS
  // сплющивает вертикальное видео в квадрат. Замеряются один раз ffprobe'ом
  // при завершении загрузки, чтобы не гонять его на каждый запрос метаданных.
  videoWidth    Int?
  videoHeight   Int?
  fileSize      BigInt?
  errorCategory ErrorCategory?
  // Повторы одного и того же ролика отдаются без нового скачивания (см.
  // DownloadService.findCached): YouTube идёт через прокси с оплатой за
  // гигабайты. cacheKey — площадка, id ролика, тип и качество; у карусели и
  // фотопостов его нет, их не кешируем. telegramFileId — file_id, который
  // вернул Telegram, когда бот отправил файл: по нему бот пересылает ролик
  // повторно, не загружая его вовсе. fromCache — запись выдана из кеша, через
  // прокси ничего не шло; суточный лимит трафика YouTube такие не считает.
  cacheKey       String?
  telegramFileId String?
  fromCache      Boolean        @default(false)
  // Файл скачал сам браузер (расширение, extension/), а сервер получил только
  // отчёт: POST /download/report. Файла на сервере нет, трафик сервера не
  // тратился — такие записи не входят ни в лимит YouTube, ни в объём на
  // дашборде, но считаются скачиваниями.
  clientSide     Boolean        @default(false)
  // Хеш IP посетителя сайта — для суточного лимита трафика YouTube с одного
  // адреса (входа на сайте нет, считать больше не по чему). Хранится хеш, а
  // не сам адрес: для лимита достаточно сравнивать, а адреса незачем копить.
  clientIpHash   String?
  // Файлы поста. У обычного скачивания ровно один и он же продублирован в
  // filename/downloadUrl выше — так старый код, рассчитанный на один файл,
  // продолжает работать без изменений. У карусели записей несколько.
  items         DownloadItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([botUserId])
  @@index([status])
  @@index([downloader])
  @@index([createdAt])
  @@index([cacheKey])
  @@index([clientIpHash])
}

// Один файл внутри скачивания. Отдельная таблица, а не массив в Download:
// у каждого файла свои размеры и вес, они нужны боту, чтобы Telegram не
// сплющивал вертикальные видео в альбоме.
model DownloadItem {
  id         String           @id @default(uuid())
  download   Download         @relation(fields: [downloadId], references: [id], onDelete: Cascade)
  downloadId String
  // Порядковый номер в посте, с единицы — совпадает с playlist_index у yt-dlp
  // и с порядком, в котором элементы показывает сама площадка.
  position   Int
  filename   String
  kind       DownloadItemKind @default(VIDEO)
  width      Int?
  height     Int?
  duration   Int?
  fileSize   BigInt?
  createdAt  DateTime         @default(now())

  @@unique([downloadId, position])
  @@index([downloadId])
}

enum DownloadItemKind {
  VIDEO
  PHOTO
  AUDIO
}

model BotUser {
  id                String            @id @default(uuid())
  telegramId        BigInt            @unique
  username          String?
  firstName         String?
  languageCode      String?
  // Язык бота, выбранный человеком вручную (/language): код вроде "uk".
  // null — по языку Telegram (languageCode).
  language          String?
  // Безлимит выдаётся ТОЛЬКО вручную админом через /grant и срока не имеет.
  // Купить его нельзя: платных функций в сервисе нет.
  isUnlimited       Boolean           @default(false)
  // Ставится при входе через Telegram Login Widget на сайте (см.
  // bot-user.controller.ts telegramLogin) — отдельно от firstSeenAt/lastSeenAt,
  // которые обновляются и от активности в боте. Нужно для аналитики: сколько
  // пользователей вообще заходили на сайт, а не только пользовались ботом.
  lastWebLoginAt    DateTime?
  // Когда человеку отправили единственную подсказку «как пользоваться» после
  // 48 часов молчания (см. nudge.service.ts). Непустое значение = больше не
  // писать никогда, даже если он так и не скачал ничего.
  nudgeSentAt       DateTime?
  // Когда заблокировал бота (или удалил аккаунт); null — бот ему доступен.
  // История изменений — BotBlockEvent.
  blockedAt         DateTime?
  downloads         Download[]
  activityDays      UserActivityDay[]
  blockEvents       BotBlockEvent[]
  firstSeenAt       DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())

  @@index([telegramId])
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  CONVERTING
  COMPLETED
  FAILED
  EXPIRED
}

enum Downloaders {
  YOUTUBE
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TWITTER
  VIMEO
  VK
  RUTUBE
  OKRU
  PINTEREST
  THREADS
  GETCOURSE
}

enum DownloadSource {
  BOT
  WEB
  API
  // Браузерное расширение (extension/), ходит через web/app/api/ext.
  EXTENSION
}

enum ErrorCategory {
  LOGIN_REQUIRED
  UNSUPPORTED_PLATFORM
  FORMAT_UNAVAILABLE
  YOUTUBE_AUTH_REQUIRED
  TIMEOUT
  NO_VIDEO_CONTENT
  REGION_BLOCKED
  OTHER
}

// Короткий код ссылки-приглашения в бота: t.me/<бот>?start=<code>. Telegram
// пропускает в start не больше 64 символов из [A-Za-z0-9_-], исходная ссылка
// туда не влезает — её храним здесь, а в Telegram уходит только код. Одна
// ссылка — один код (url уникален), поэтому повторная выдача ничего не плодит.
model ShareLink {
  id        String   @id @default(uuid())
  code      String   @unique
  url       String   @unique
  createdAt DateTime @default(now())
}

// Дни, когда пользователь был активен (UTC): одна строка на человека и день.
// lastSeenAt хранит только последний визит, и по нему MAU за прошлые даты не
// посчитать — отсюда графики MAU по дням и месяцам на дашборде. Пишется там
// же, где обновляется lastSeenAt (BotUserService.upsertBotUser), поэтому
// «активный» здесь значит ровно то же, что в карточках DAU/WAU/MAU. Дни до
// появления таблицы восстановлены миграцией из скачиваний и дат визитов.
model UserActivityDay {
  botUser   BotUser  @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  botUserId String
  day       DateTime @db.Date

  @@id([botUserId, day])
  @@index([day])
}

// Человек заблокировал бота (blocked) или разблокировал его — для графиков
// блокировок в дашборде. Пишется только при смене состояния BotUser.blockedAt.
// source: telegram — Telegram сам сообщил боту (my_chat_member); check — тихая проверка
// scripts/check-blocked.mjs; baseline — заблокировали до начала учёта
// (29.10.2026), когда именно — неизвестно, на графиках по периодам не видны.
model BotBlockEvent {
  id        String   @id @default(uuid())
  botUser   BotUser  @relation(fields: [botUserId], references: [id], onDelete: Cascade)
  botUserId String
  blocked   Boolean
  source    String
  at        DateTime @default(now())

  @@index([at])
}

// Настройки режима для групп (bot/src/handlers/group.ts), одна строка на чат.
// Нет строки — у группы настройки по умолчанию. Меняют только админы группы
// командой /settings; права проверяет бот, сервер доверяет ему по API-ключу.
model GroupSettings {
  // Идентификатор чата Telegram (у групп отрицательный).
  chatId      BigInt   @id
  // Удалять сообщение со ссылкой, когда видео отправлено. Только если в нём
  // ничего, кроме ссылок, нет, и только если бот — админ с правом удалять.
  deleteLinks Boolean  @default(false)
  // Подпись под видео: full — как в личке, short — название и источник,
  // none — без подписи.
  caption     String   @default("full")
  // standard — 720p или ближе к нему, max — лучшее, что влезает в лимит Telegram.
  quality     String   @default("standard")
  // Качать и видео длиннее 15 минут. По умолчанию нет: длинное видео в группу
  // чаще кидают обсудить, а не скачать (handlers/group.ts).
  longVideos  Boolean  @default(false)
  // Кто может подключать к группе свой вход на площадках (UserCookie):
  // admins — только администраторы, all — любой участник.
  cookiesBy   String   @default("admins")
  // Язык ответов бота в группе. null — каждому на языке его Telegram (или
  // выбранном им в /language).
  language    String?
  updatedAt   DateTime @updatedAt
}

// Куки, которые люди подключили боту сами (модуль user-cookies): чтобы бот
// качал то, что видно только вошедшим (сторис Instagram, закрытые записи), —
// от их аккаунта. Область (scope) — где ими можно пользоваться: личка
// человека («user:<telegramId>») или одна группа («chat:<chatId>»). В других
// группах те же куки не работают никогда — там их подключают заново.
//
// data — только Netscape-текст куки одной площадки (lib/user-cookies.ts),
// зашифрованный AES-256-GCM ключом USER_COOKIES_KEY (lib/cookie-crypto.ts).
// В открытом виде куки не лежат нигде, кроме одноразового файла для yt-dlp
// на время одного запроса.
model UserCookie {
  id              String    @id @default(uuid())
  scope           String
  platform        String
  ownerTelegramId BigInt
  ownerName       String?
  // Язык владельца — на нём пишем, если вход перестал работать.
  ownerLang       String?
  data            Bytes
  // Подряд идущие отказы «вход не действует». Сбрасывается удачей; на
  // третьем запись выключается (invalidAt) и владелец получает сообщение.
  failures        Int       @default(0)
  invalidAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())

  // Один человек — одна запись площадки в каждой области: повторное
  // подключение заменяет старые куки свежими.
  @@unique([scope, platform, ownerTelegramId])
  @@index([ownerTelegramId])
}

// Одноразовый код от кнопки «Подключить аккаунт» в расширении: куки уходят на
// сервер напрямую, а в чат человек отправляет только код (/connect <код>).
// Живёт 10 минут и удаляется при первом использовании.
model CookieConnectCode {
  code      String   @id
  platform  String
  data      Bytes
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Статьи блога, опубликованные в канале новостей (бот, blog-channel.ts).
// Строка создаётся ДО отправки — так два запуска бота не опубликуют одну
// статью дважды; не отправилось — строку удаляют.
model ChannelPost {
  slug        String   @id
  messageId   Int?
  publishedAt DateTime @default(now())
}
