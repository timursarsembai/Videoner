# Шаблон переменных для production-деплоя на VPS.
# Скопируйте в .env рядом с docker-compose.prod.yml и заполните:
#   cp .env.prod.example .env

# Публичный домен, направленный на VPS (без https://). Заведён в Nginx Proxy Manager.
PUBLIC_DOMAIN=videoner.sarsembai.dev

# Имя внешней docker-сети вашего Nginx Proxy Manager
NPM_NETWORK=proxy-network

# Телеграм
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Общий секрет между server/web/bot. Сгенерировать: openssl rand -hex 32  (добавьте префикс dk_)
API_KEY=

# Необязательно
POSTGRES_PASSWORD=postgres
ADMIN_EMAIL=admin@localhost

# Telegram chat ID администратора — сюда сервер шлёт алерт, когда YouTube требует
# обновить cookies ("Sign in to confirm you're not a bot"). Узнать свой ID: @userinfobot
ADMIN_CHAT_ID=

# Необязательно: статический ISP-прокси (например, IPRoyal Static Residential) для YouTube —
# обходит блокировку YouTube по IP дата-центра VPS. Формат: http://user:pass@host:port
YOUTUBE_PROXY_URL=

# Экономия трафика прокси на YouTube (необязательно, ниже — значения по умолчанию).
# Потолок качества по короткой стороне кадра:
YOUTUBE_MAX_HEIGHT=720
# Ролики длиннее этого числа минут — с потолком пониже (0 — не различать длинные):
YOUTUBE_LONG_VIDEO_MINUTES=30
YOUTUBE_LONG_MAX_HEIGHT=480
# Суточный лимит трафика YouTube на одного человека, ГБ (0 — без лимита):
YOUTUBE_DAILY_GB=2

# Предел размера одного файла, МБ: более тяжёлое качество отклоняется до скачивания.
# Бот — не больше 2000 (предел Telegram для ботов), сайт — сколько не жалко диска.
MAX_FILE_SIZE_BOT_MB=2000
MAX_FILE_SIZE_WEB_MB=4096

# Счётчик Яндекс.Метрики. Пусто/не задано — счётчик на сайт не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Канал для кнопки «Поделиться» в боте (@имя или -100…). Бот — админ канала.
# Пусто — кнопки нет.
TELEGRAM_CHANNEL_ID=
